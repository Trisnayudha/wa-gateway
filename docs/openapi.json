{
    "openapi": "3.0.3",
    "info": {
        "title": "WA Gateway API",
        "version": "1.0.0",
        "description": "Internal WhatsApp Gateway API (multi-device) - send message via X-API-KEY."
    },
    "servers": [
        {
            "url": "http://localhost:3000"
        }
    ],
    "paths": {
        "/api/send": {
            "post": {
                "summary": "Send WhatsApp message (text and/or attachment)",
                "description": "Send text message, attachment message, or both using API key bound to a device.",
                "parameters": [
                    {
                        "name": "X-API-KEY",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "API key generated per device."
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "to"
                                ],
                                "properties": {
                                    "to": {
                                        "type": "string",
                                        "example": "62812xxxxxxx"
                                    },
                                    "text": {
                                        "type": "string",
                                        "example": "Hello from WA Gateway"
                                    },
                                    "attachmentUrl": {
                                        "type": "string",
                                        "example": "https://example.com/invoice.pdf",
                                        "description": "Public HTTP/HTTPS URL to file/image/video/document attachment"
                                    },
                                    "attachmentCaption": {
                                        "type": "string",
                                        "example": "Invoice April 2026",
                                        "description": "Optional caption for attachment. If omitted, text will be used as caption when available."
                                    },
                                    "attachmentFilename": {
                                        "type": "string",
                                        "example": "invoice-april-2026.pdf",
                                        "description": "Optional filename override for WhatsApp attachment display"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Sent",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ok": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "deviceId": {
                                            "type": "string"
                                        },
                                        "messageId": {
                                            "type": "string",
                                            "nullable": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized (invalid API key)"
                    },
                    "500": {
                        "description": "Server Error"
                    },
                    "503": {
                        "description": "Device not ready"
                    }
                }
            }
        },
        "/api/admin/devices": {
            "get": {
                "summary": "List devices",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            },
            "post": {
                "summary": "Create device",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "IM Notif 1"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Created"
                    },
                    "400": {
                        "description": "Bad Request"
                    }
                }
            }
        },
        "/api/admin/devices/{id}/qr": {
            "get": {
                "summary": "Get QR for a device",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "QR returned"
                    },
                    "404": {
                        "description": "QR not available"
                    }
                }
            }
        },
        "/api/admin/devices/{id}/api-keys": {
            "post": {
                "summary": "Create API key for a device",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "label"
                                ],
                                "properties": {
                                    "label": {
                                        "type": "string",
                                        "example": "laravel-prod"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "API key created (shown once)"
                    },
                    "400": {
                        "description": "Bad Request"
                    }
                }
            }
        }
    }
}