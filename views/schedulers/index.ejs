<%
var flashHtml = '';
if (flash && flash.message) {
    flashHtml = '<div class="alert alert-' + flash.type + ' alert-dismissible fade show mb-3" role="alert">'
              + flash.message
              + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
}

var tableRows = (schedulers || []).map(function(s) {
    var device = (devices || []).find(function(d){ return d.id === s.device_id; });
    var deviceName = device ? device.name : s.device_id.slice(0,8) + '...';

    var isRunning = runningIds && runningIds.has(s.id);
    var runningBadge = isRunning
        ? '<span class="badge text-bg-success"><i class="bi bi-play-fill"></i> Berjalan</span>'
        : '<span class="badge text-bg-secondary"><i class="bi bi-pause-fill"></i> Idle</span>';

    var typeBadge = s.scheduler_type === 'registration'
        ? '<span class="badge text-bg-info">Registration</span>'
        : '<span class="badge text-bg-primary">Check-in</span>';

    var checked = s.is_active ? 'checked' : '';

    return '<tr id="row-' + s.id + '">'
        + '<td><div class="fw-semibold">' + s.name + '</div>'
        + '<div class="text-secondary small">Event ID: <code>' + s.event_id + '</code></div></td>'
        + '<td>' + typeBadge + '</td>'
        + '<td><span class="badge text-bg-secondary">' + deviceName + '</span></td>'
        + '<td><code class="small">' + s.cron_expression + '</code>'
        + '<div class="text-secondary small">' + (s.timezone || 'Asia/Jakarta') + '</div></td>'
        + '<td class="text-truncate" style="max-width:180px"><code class="small">' + s.group_id + '</code></td>'
        + '<td><div class="form-check form-switch mb-0">'
        + '<input class="form-check-input toggle-sched" type="checkbox" data-id="' + s.id + '" ' + checked + ' style="cursor:pointer">'
        + '</div></td>'
        + '<td>' + runningBadge + '</td>'
        + '<td class="pe-3">'
        + '<a href="/schedulers/' + s.id + '/edit" class="btn btn-outline-primary btn-sm me-1"><i class="bi bi-pencil"></i> Edit</a>'
        + '<form method="POST" action="/schedulers/' + s.id + '/delete" class="d-inline"'
        + ' onsubmit="return confirm(\'Hapus scheduler ini?\')">'
        + '<button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>'
        + '</form>'
        + '</td></tr>';
}).join('');

var emptyRow = '<tr><td colspan="8" class="text-center text-secondary py-5">'
    + '<i class="bi bi-alarm d-block fs-2 mb-2 opacity-50"></i>'
    + 'Belum ada scheduler. <a href="/schedulers/new">Buat sekarang</a>.'
    + '</td></tr>';

var toastScript = '<div id="toast-container" class="position-fixed bottom-0 end-0 p-3" style="z-index:1100"></div>'
    + '<script>'
    + 'function showToast(msg,type){'
    + 'var id="t_"+Date.now();var el=document.createElement("div");'
    + 'el.id=id;el.className="toast align-items-center "+(type==="success"?"text-bg-success":"text-bg-danger")+" border-0 show";'
    + 'el.setAttribute("role","alert");'
    + 'el.innerHTML="<div class=\\"d-flex\\"><div class=\\"toast-body\\">"+msg+"</div>'
    + '<button type=\\"button\\" class=\\"btn-close btn-close-white me-2 m-auto\\" data-bs-dismiss=\\"toast\\"></button></div>";'
    + 'document.getElementById("toast-container").appendChild(el);setTimeout(function(){el.remove();},3500);}'
    + 'document.querySelectorAll(".toggle-sched").forEach(function(el){'
    + 'el.addEventListener("change",async function(){'
    + 'var id=this.dataset.id,prev=!this.checked,self=this;'
    + 'try{'
    + 'var res=await fetch("/schedulers/"+id+"/toggle",{method:"POST",headers:{"X-Requested-With":"XMLHttpRequest"}});'
    + 'var data=await res.json().catch(function(){return{};});'
    + 'if(!data.ok)throw new Error(data.message||"Gagal");'
    + 'self.checked=data.is_active;'
    + 'showToast("Scheduler "+(data.is_active?"diaktifkan":"dinonaktifkan"),"success");'
    + '}catch(err){self.checked=prev;showToast("Gagal: "+err.message,"danger");}'
    + '});});'
    + '<\/script>';

var body = flashHtml
    + '<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">'
    + '<div><h5 class="mb-0">Event Schedulers</h5>'
    + '<div class="text-secondary small">Jadwalkan pengiriman summary check-in event ke grup WA secara otomatis.</div></div>'
    + '<a href="/schedulers/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i> Buat Scheduler</a>'
    + '</div>'
    + '<div class="card card-shadow">'
    + '<div class="card-body p-0">'
    + '<div class="table-responsive">'
    + '<table class="table table-hover align-middle mb-0">'
    + '<thead class="table-light"><tr>'
    + '<th class="ps-3">Nama / Event</th><th>Tipe</th><th>Device</th><th>Jadwal</th>'
    + '<th>Target Grup</th><th>Aktif</th><th>Status</th><th class="pe-3">Aksi</th>'
    + '</tr></thead>'
    + '<tbody>' + (tableRows || emptyRow) + '</tbody>'
    + '</table></div></div></div>'
    + toastScript;
%>
<%- include('../layout', { title: 'Event Schedulers', active: 'schedulers', user: user, body: body }) %>
