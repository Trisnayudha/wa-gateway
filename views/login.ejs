<!doctype html>
<html>

<head>
    <meta charset="utf-8" />
    <title>Login</title>
</head>

<body style="font-family:system-ui;padding:24px;max-width:420px">
    <h2>WA Gateway Login</h2>
    <% if (error) { %>
        <p style="color:#c33">
            <%= error %>
        </p>
        <% } %>
            <form method="POST" action="/login">
                <div><input name="email" placeholder="Email" style="width:100%;padding:10px;margin:8px 0" /></div>
                <div><input type="password" name="password" placeholder="Password"
                        style="width:100%;padding:10px;margin:8px 0" /></div>
                <button style="padding:10px 12px">Login</button>
            </form>
</body>

</html>