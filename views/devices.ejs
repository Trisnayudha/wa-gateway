<% const rows=devices.map(d=> `
    <tr>
        <td>
            <div class="fw-semibold">${d.name}</div>
            <div class="text-secondary small"><code>${d.id}</code></div>
        </td>
        <td>
            ${
            d.status === 'READY'
            ? '<span class="badge text-bg-success">READY</span>'
            : '<span class="badge text-bg-secondary">DISCONNECTED</span>'
            }
        </td>
        <td><code>${d.last_event || '-'}</code></td>
    </tr>
    `).join('');

    const body = `
    <div class="card card-shadow">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0">Devices</h5>
                    <div class="text-secondary small">Monitor koneksi device dan status session.</div>
                </div>
                <a class="btn btn-outline-primary btn-sm" href="/" target="_blank">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Open Public Admin (QR Tool)
                </a>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Status</th>
                            <th>Last Event</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${rows || `<tr>
                            <td colspan="3" class="text-secondary">No devices</td>
                        </tr>`}
                    </tbody>
                </table>
            </div>

            <div class="alert alert-warning mb-0">
                <b>Next step:</b> nanti kita pindahkan fitur <i>Add Device</i>, <i>Show QR</i>, dan <i>Create API
                    Key</i> langsung ke halaman ini biar full seperti NusaGateway.
            </div>
        </div>
    </div>
    `;
    %>

    <%- include('layout', { title: 'Devices' , active: 'devices' , user, body }) %>