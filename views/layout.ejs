<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= title || "WA Gateway" %>
  </title>

  <!-- Bootstrap + Icons (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    body {
      background: #f4f6f9;
    }

    .sidebar {
      width: 260px;
      min-height: 100vh;
      background: #0f172a;
      color: #cbd5e1;
      position: sticky;
      top: 0;
    }

    .sidebar .brand {
      font-weight: 700;
      color: #fff;
    }

    .sidebar a {
      color: #cbd5e1;
      text-decoration: none;
      display: flex;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 10px;
    }

    .sidebar a:hover {
      background: rgba(255, 255, 255, .06);
      color: #fff;
    }

    .sidebar a.active {
      background: rgba(59, 130, 246, .18);
      color: #fff;
    }

    .content {
      padding: 22px;
    }

    .card-shadow {
      box-shadow: 0 10px 20px rgba(0, 0, 0, .06);
      border: 0;
    }

    .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(13, 110, 253, .12);
      color: #0d6efd;
    }

    .topbar {
      background: #fff;
      border-bottom: 1px solid #e9ecef;
    }
  </style>
</head>

<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <aside class="sidebar p-3 d-none d-lg-block">
      <div class="d-flex align-items-center gap-2 mb-4">
        <div class="stat-icon" style="background:rgba(255,255,255,.08);color:#fff">
          <i class="bi bi-chat-dots"></i>
        </div>
        <div>
          <div class="brand">WA Gateway</div>
          <div class="small text-secondary">Internal Panel</div>
        </div>
      </div>

      <nav class="d-grid gap-1">
        <a class="<%= active === 'dashboard' ? 'active' : '' %>" href="/dashboard">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a class="<%= active === 'devices' ? 'active' : '' %>" href="/devices">
          <i class="bi bi-phone"></i> Devices
        </a>
        <a class="<%= active === 'keys' ? 'active' : '' %>" href="/api-keys">
          <i class="bi bi-key"></i> API Keys
        </a>
        <a class="<%= active === 'messages' ? 'active' : '' %>" href="/messages">
          <i class="bi bi-envelope-paper"></i> Messages
        </a>
        <a class="<%= active === 'groups' ? 'active' : '' %>" href="/groups">
          <i class="bi bi-people"></i> Groups
        </a>
        <a class="<%= active === 'commands' ? 'active' : '' %>" href="/commands">
          <i class="bi bi-terminal"></i> Commands
        </a>
        <a class="<%= active === 'docs' ? 'active' : '' %>" href="/docs" target="_blank">
          <i class="bi bi-journal-text"></i> API Docs
        </a>
      </nav>

      <hr class="border-secondary my-4" />

      <div class="small">
        <div class="text-secondary mb-1">Signed in as</div>
        <div class="text-white fw-semibold">
          <%= user?.name || '-' %>
        </div>
        <div class="text-secondary">
          <%= user?.email || '-' %>
        </div>
      </div>
    </aside>

    <!-- Main -->
    <div class="flex-grow-1">
      <!-- Topbar -->
      <div class="topbar px-3 py-2 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <span class="badge text-bg-primary rounded-pill">v1</span>
          <span class="fw-semibold">
            <%= title || "Dashboard" %>
          </span>
        </div>

        <div class="d-flex align-items-center gap-2">
          <span class="small text-secondary d-none d-md-inline">
            <i class="bi bi-person-circle me-1"></i>
            <%= user?.name || '-' %> (<%= user?.role || '-' %>)
          </span>
          <form method="POST" action="/logout" class="m-0">
            <button class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-box-arrow-right me-1"></i> Logout
            </button>
          </form>
        </div>
      </div>

      <main class="content">
        <%- body %>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>